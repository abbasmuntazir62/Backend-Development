<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <a href="bg-red-500 rounded-md px-3 py-2" href="/logout">logout</a>
        <h3 class="text-3xl mb-3"> Hello, <%= user.name%></h3>
        <h5>you can create a new posts.</h5>
        <form method="post"action="/post">

<textarea placeholder="whats's on your mind?">
<input type="create new post">
        </form>

<div class="posts mt-32">
    <h3>your posts.</h3>
    <% user.reverse().posts.forEach(function(post){ %> 
        
   <% }) %>

<div class="postscontainer">

<div class="posts w-1/3 p-5">
    <h4>@someusername</h4>
    <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Voluptas quidem magnam numquam earum exercitationem eius voluptatem error vel similique molestias possimus a amet deleniti quis quibusdam laborum, ipsam magni non!</p>
    <small class="mt-2 inline-block"><%= post,likes.length %> likes</small>
    <div class="btns flex">
        <a class="text-blue-500" href="/like<%= post._id %>">
            <%= post.likes.indexof(user._id) === -1 ? "like": "unlike"%>
        </a>
        <a href="/edit/<%= post._id %>">edit</a>
    </div>
</div>

</div>

</div>



    </div>
</body>
</html>